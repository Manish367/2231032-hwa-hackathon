{
  "version": 2,
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "routes": [
    { "src": "/api/.*", "dest": "/api/index.js" },
    { "src": "/(.+\\.(css|js|html|json|png|jpg|jpeg|gif|svg|webp|avif|ico|woff|woff2))", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}